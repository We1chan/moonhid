import {
  "We1chan/moonhid" @hid,
  "We1chan/moonhid/examples",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

pkgtype(kind: "executable")

supported_targets = "+native+js"

options(
  "native-stub": [ "stderr_native.c" ],
  targets: { "io_native.mbt": [ "native" ], "io_js.mbt": [ "js" ] },
)
