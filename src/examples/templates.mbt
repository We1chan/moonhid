///|
/// Generates the same descriptor as the independently stored mouse fixture.
pub fn mouse_descriptor() -> Result[Bytes, @hid.Diagnostic] {
  @hid.DescriptorBuilder::new()
  .usage_page(1)
  .usage(2)
  .collection(1)
  .usage_page(9)
  .usage_range(1, 3)
  .logical_range(0L, 1L)
  .report_size(1)
  .report_count(3)
  .input(2)
  .report_size(5)
  .report_count(1)
  .input(1)
  .usage_page(1)
  .usage(0x30)
  .usage(0x31)
  .usage(0x38)
  .logical_range(-127L, 127L)
  .report_size(8)
  .report_count(3)
  .input(6)
  .end_collection()
  .build()
}

///|
/// Boot-style keyboard Input and LED Output descriptor, without changing protocol.
pub fn keyboard_descriptor() -> Result[Bytes, @hid.Diagnostic] {
  @hid.DescriptorBuilder::new()
  .usage_page(1)
  .usage(6)
  .collection(1)
  .usage_page(7)
  .usage_range(0xe0, 0xe7)
  .logical_range(0L, 1L)
  .report_size(1)
  .report_count(8)
  .input(2)
  .report_size(8)
  .report_count(1)
  .input(1)
  .usage_range(0, 0x65)
  .logical_range(0L, 0x65L)
  .report_size(8)
  .report_count(6)
  .input(0)
  .usage_page(8)
  .usage_range(1, 5)
  .logical_range(0L, 1L)
  .report_size(1)
  .report_count(5)
  .output(2)
  .report_size(3)
  .report_count(1)
  .output(1)
  .end_collection()
  .build()
}

///|
/// Twelve buttons and signed 16-bit axes, numbered Input report 7.
pub fn gamepad_descriptor() -> Result[Bytes, @hid.Diagnostic] {
  @hid.DescriptorBuilder::new()
  .usage_page(1)
  .usage(5)
  .collection(1)
  .report_id(7)
  .usage_page(9)
  .usage_range(1, 12)
  .logical_range(0L, 1L)
  .report_size(1)
  .report_count(12)
  .input(2)
  .report_size(4)
  .report_count(1)
  .input(1)
  .usage_page(1)
  .usage(0x30)
  .usage(0x31)
  .logical_range(-32768L, 32767L)
  .report_size(16)
  .report_count(2)
  .input(2)
  .end_collection()
  .build()
}
